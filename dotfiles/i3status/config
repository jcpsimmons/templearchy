general {
  colors = true
  interval = 1
  color_good = "#00FF00"
  color_degraded = "#FFFF00"
  color_bad = "#E50000"
}

order += "cpu_usage"
order += "memory"
order += "tztime local"

cpu_usage {
  format = "CPU %usage"
}

memory {
  format = "MEM %used"
  threshold_degraded = "10%"
  threshold_critical = "5%"
}

tztime local {
  format = "TEMPLEARCHY %Y-%m-%d %H:%M:%S"
}
