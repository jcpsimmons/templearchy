#!/usr/bin/env bash
# File-backed LLM prompt queue. No secrets. Drain with aichat when you have a key.
set -euo pipefail

if [[ -z "${TEMPLEARCHY_QUEUE:-}" ]]; then
  if [[ -d /mnt/host ]]; then
    TEMPLEARCHY_QUEUE=/mnt/host/queue
  else
    TEMPLEARCHY_QUEUE="${HOME}/.local/share/templearchy/queue"
  fi
fi
DIR="${TEMPLEARCHY_QUEUE}"
mkdir -p "${DIR}"

usage() {
  cat <<'EOF'
q add <text>     enqueue a prompt
q list           show queued prompts
q next           print and remove the oldest prompt
q drain          run aichat on each prompt (needs AICHAT_API_KEY or similar)
q watch          reprint the queue every 2s
q clear          delete the queue

This is the boring queue. Put prompts in. Drain them from nvim/tmux.
EOF
}

next_id() {
  local last
  last="$(find "${DIR}" -maxdepth 1 -name '*.txt' 2>/dev/null | sort | tail -n 1 || true)"
  if [[ -z "${last}" ]]; then
    printf '%04d' 1
  else
    printf '%04d' $((10#$(basename "${last}" .txt) + 1))
  fi
}

cmd="${1:-}"
shift || true

case "${cmd}" in
  add)
    if [[ $# -eq 0 ]]; then
      echo "q add <text>" >&2
      exit 1
    fi
    id="$(next_id)"
    printf '%s\n' "$*" >"${DIR}/${id}.txt"
    echo "queued ${id}"
    ;;
  list)
    found=0
    while IFS= read -r f; do
      found=1
      printf '%s  %s\n' "$(basename "${f}" .txt)" "$(tr '\n' ' ' <"${f}")"
    done < <(find "${DIR}" -maxdepth 1 -name '*.txt' | sort)
    if [[ "${found}" -eq 0 ]]; then
      echo "(empty)"
    fi
    ;;
  next)
    first="$(find "${DIR}" -maxdepth 1 -name '*.txt' | sort | head -n 1 || true)"
    if [[ -z "${first}" ]]; then
      echo "(empty)" >&2
      exit 1
    fi
    cat "${first}"
    rm -f "${first}"
    ;;
  drain)
    if ! command -v aichat >/dev/null 2>&1; then
      echo "aichat not on PATH" >&2
      exit 1
    fi
    while first="$(find "${DIR}" -maxdepth 1 -name '*.txt' | sort | head -n 1)" && [[ -n "${first}" ]]; do
      echo "==== $(basename "${first}") ===="
      aichat -H <"${first}"
      rm -f "${first}"
    done
    ;;
  watch)
    while true; do
      clear
      echo "TEMPLEARCHY QUEUE"
      echo
      "$0" list
      sleep 2
    done
    ;;
  clear)
    find "${DIR}" -maxdepth 1 -name '*.txt' -delete
    echo "cleared"
    ;;
  *)
    usage
    exit 1
    ;;
esac
